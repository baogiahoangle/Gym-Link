<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="30dp">

    <ImageView
        android:id="@+id/iv_logout_image"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:scaleType="fitCenter"
        android:src="@drawable/complete_workout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"/>

    <TextView
        android:id="@+id/tv_logout_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bạn muốn rời đi sao?"
        android:textColor="#1D1617"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/iv_logout_image" />

    <TextView
        android:id="@+id/tv_logout_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chúng mình sẽ rất nhớ bạn đấy. Hãy sớm quay lại để tiếp tục hành trình rèn luyện nhé!"
        android:textColor="#7B6F72"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/tv_logout_title" />

    <Button
        android:id="@+id/btn_confirm_logout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/custombutton"
        android:text="Đồng ý thoát"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/btn_cancel_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ở lại thêm chút nữa"
        android:textColor="#ADA4A5"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm_logout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>